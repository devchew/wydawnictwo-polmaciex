---
const { title = 'Polmaciex — wydawnictwo dobrych opowieści', description = 'Wydawnictwo Polmaciex. Książki, do których chce się wracać.' } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#f8f7f2" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header"><a class="wordmark" href="/" aria-label="Polmaciex — strona główna"><span class="wordmark-mark">p.</span><span>polmaciex</span></a><nav aria-label="Nawigacja główna"><a href="/#ksiazki">Książki</a><a href="/#o-nas">O wydawnictwie</a></nav><a class="header-note" href="/#ksiazki">Czytaj po swojemu <span aria-hidden="true">↗</span></a></header>
    <main><slot /></main>
    <footer class="site-footer"><a class="wordmark footer-wordmark" href="/"><span class="wordmark-mark">p.</span><span>polmaciex</span></a><p>Wydajemy opowieści, które zostają na dłużej.</p><span>© {new Date().getFullYear()} Polmaciex</span></footer>
  </body>
</html>
<style is:global>
  :root { font-family: 'DM Sans', sans-serif; color: #24362d; background: #f8f7f2; font-synthesis: none; text-rendering: optimizeLegibility; } * { box-sizing: border-box; } html { scroll-behavior: smooth; } body { margin: 0; min-width: 320px; } a { color: inherit; }
  .site-header { height: 82px; max-width: 1280px; margin: auto; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e9e7df; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: #24362d; text-decoration: none; font-weight: 700; letter-spacing: -.045em; font-size: 19px; }.wordmark-mark { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 50%; background: #d9e5d5; color: #42624f; font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 600; }
  .site-header nav { display: flex; gap: 38px; }.site-header nav a, .header-note { text-decoration: none; font-size: 13px; color: #526158; }.site-header nav a:hover, .header-note:hover { color: #bc6848; }.header-note { font-weight: 600; }.header-note span { margin-left: 8px; color: #bc6848; }
  .site-footer { max-width: 1200px; margin: auto; padding: 32px 40px; border-top: 1px solid #e9e7df; display: flex; align-items: center; justify-content: space-between; color: #727a71; font-size: 12px; }.footer-wordmark { color: #24362d; font-size: 16px; }.footer-wordmark .wordmark-mark { width: 26px; height: 26px; font-size: 16px; }.site-footer p { margin: 0; }
  @media (max-width: 700px) { .site-header { height: 70px; padding: 0 20px; }.site-header nav { gap: 16px; }.site-header nav a { font-size: 12px; }.header-note { display: none; }.site-footer { padding: 25px 20px; flex-wrap: wrap; gap: 14px; }.site-footer p { order: 3; width: 100%; } }
</style>
