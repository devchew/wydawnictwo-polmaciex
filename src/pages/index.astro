---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books, getAuthor } from '../data/books';
const featuredBooks = books.filter((book) => book.featured);
---
<BaseLayout>
  <section class="hero" id="o-nas"><div class="hero-copy"><p class="eyebrow"><span></span> Wydawnictwo dobrych opowieści</p><h1>Historie, które<br />zostają <em>z Tobą.</em></h1><p class="hero-description">Wierzymy w książki, które pomagają zwolnić, spojrzeć uważniej i odnaleźć coś swojego między wierszami.</p><a class="hero-link" href="#ksiazki">Poznaj nasze książki <span aria-hidden="true">↓</span></a><div class="hero-signature"><span class="signature-line"></span><span>Niezależne wydawnictwo<br />z miłości do opowieści</span></div></div>
    <div class="hero-art" aria-label="Ilustracja książek i liści" role="img"><div class="sun"></div><div class="leaf leaf-one"></div><div class="leaf leaf-two"></div><div class="book-stack"><div class="stack-book stack-back"></div><div class="stack-book stack-mid"></div><div class="stack-book stack-front"><span>polmaciex</span><b>czytaj<br />spokojnie</b><i></i></div></div><span class="art-caption">Dobre słowo<br />na dobry moment</span></div>
  </section>
  <section class="books-section" id="ksiazki"><div class="section-heading"><div><p class="eyebrow"><span></span> Nasze książki</p><h2>Znajdź swoją <em>historię.</em></h2></div><p class="section-note">Każda z nich zaczyna się od<br />małego „a co, jeśli…?”</p></div><div class="book-grid">{featuredBooks.map((book) => <BookCard book={book} authorName={getAuthor(book.authorSlug)?.name ?? ''} />)}</div><p class="catalog-note">Pełna lista naszych książek jest zawsze o krok od Ciebie.</p></section>
  <section class="manifesto"><span class="manifesto-mark">“</span><p>Nie muszą być głośne,<br />żeby <em>zostały z nami.</em></p><span class="manifesto-caption">Wydajemy książki z uważnością — na słowa, ludzi i świat wokół.</span></section>
</BaseLayout>
<style>
  .hero { max-width: 1200px; min-height: 530px; margin: auto; padding: 65px 40px 58px; display: grid; grid-template-columns: 1fr .93fr; align-items: center; gap: 50px; }.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0; color: #747d72; font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #c67d5a; } h1, h2, .manifesto p { font-family: 'Playfair Display', serif; font-weight: 400; letter-spacing: -.045em; } h1 { margin: 23px 0 18px; color: #293b31; font-size: clamp(52px, 6vw, 76px); line-height: 1.05; } h1 em, h2 em, .manifesto em { color: #b46d4e; font-weight: 400; }.hero-description { max-width: 405px; margin: 0; color: #70796f; font-size: 14px; line-height: 1.85; }.hero-link { display: inline-flex; align-items: center; gap: 18px; margin-top: 27px; color: #375342; text-decoration: none; font-size: 12px; font-weight: 700; }.hero-link span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid #c5d0c3; border-radius: 50%; color: #b46d4e; }.hero-signature { display: flex; align-items: center; gap: 13px; margin-top: 44px; color: #93988e; font-size: 10px; line-height: 1.55; }.signature-line { width: 37px; height: 1px; background: #c67d5a; }
  .hero-art { position: relative; min-height: 380px; overflow: hidden; border-radius: 3px; background: #e8ede3; }.sun { position: absolute; top: 42px; right: 65px; width: 133px; height: 133px; border-radius: 50%; background: #d5a583; opacity: .85; }.book-stack { position: absolute; left: 50%; top: 52%; width: 220px; height: 280px; transform: translate(-50%, -45%) rotate(-4deg); }.stack-book { position: absolute; width: 180px; height: 255px; border-radius: 2px 5px 5px 2px; box-shadow: 12px 16px 25px #34473b22; }.stack-back { left: 31px; top: 12px; transform: rotate(13deg); background: #879783; }.stack-mid { left: 19px; top: 6px; transform: rotate(7deg); background: #bc8c69; }.stack-front { left: 2px; top: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 19px 20px; color: #f5efe3; background: #435a49; }.stack-front span { font-size: 8px; letter-spacing: .13em; text-transform: uppercase; }.stack-front b { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 400; line-height: 1.1; }.stack-front i { width: 30px; height: 1px; background: #d8a27d; }.leaf { position: absolute; border: 1px solid #9baa93; width: 95px; height: 42px; border-radius: 100% 0 100% 0; opacity: .8; }.leaf::after { content: ''; position: absolute; left: 8px; right: 8px; top: 20px; height: 1px; background: #9baa93; transform: rotate(-22deg); }.leaf-one { left: 30px; top: 65px; transform: rotate(34deg); }.leaf-two { right: 12px; bottom: 52px; transform: rotate(215deg) scale(.8); }.art-caption { position: absolute; right: 26px; bottom: 27px; color: #738070; font-family: 'Playfair Display', serif; font-size: 13px; line-height: 1.5; text-align: right; }
  .books-section { max-width: 1200px; margin: auto; padding: 30px 40px 88px; }.section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 35px; }.section-heading h2 { margin: 12px 0 0; font-size: clamp(34px, 4vw, 47px); line-height: 1.1; }.section-note { margin: 0 0 4px; color: #858a80; font-size: 11px; line-height: 1.7; }.book-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }.catalog-note { margin: 30px 0 0; text-align: center; color: #8a8d84; font-size: 11px; }.manifesto { min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 45px 20px; background: #e9ede5; text-align: center; }.manifesto-mark { color: #bd7958; font-family: 'Playfair Display', serif; font-size: 54px; line-height: .8; }.manifesto p { margin: 16px 0; font-size: clamp(32px, 4vw, 44px); line-height: 1.2; }.manifesto-caption { color: #7c8479; font-size: 11px; }
  @media (max-width: 800px) { .hero { grid-template-columns: 1fr .8fr; gap: 24px; padding: 50px 25px; min-height: 480px; }.hero-art { min-height: 320px; }.book-stack { transform: translate(-50%, -45%) scale(.8) rotate(-4deg); }.books-section { padding: 20px 25px 65px; }.book-grid { grid-template-columns: repeat(2, 1fr); gap: 34px 20px; } } @media (max-width: 560px) { .hero { display: flex; flex-direction: column; align-items: stretch; gap: 28px; padding: 43px 20px 42px; }.hero-art { min-height: 300px; }.hero-signature { margin-top: 26px; }.section-heading { align-items: start; gap: 10px; flex-direction: column; margin-bottom: 25px; }.section-note br { display: none; }.books-section { padding: 13px 20px 58px; }.book-grid { gap: 27px 14px; }.book-info { padding-top: 11px; }.book-author, .book-year { font-size: 10px; }.manifesto { min-height: 260px; } }
</style>
