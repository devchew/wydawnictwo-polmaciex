---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { books, getAuthor } from '../../data/books';
export function getStaticPaths() { return books.map((book) => ({ params: { slug: book.slug }, props: { book } })); }
const { book } = Astro.props;
const author = getAuthor(book.authorSlug)!;
const otherBooks = books.filter((item) => item.authorSlug === author.slug && item.slug !== book.slug);
---
<BaseLayout title={`${book.title} — Polmaciex`} description={book.description}>
  <div class="breadcrumbs"><a href="/">Strona główna</a><span>/</span><a href="/#ksiazki">Książki</a><span>/</span><span>{book.title}</span></div>
  <article class="detail"><div class="cover-wrap"><img src={book.cover} alt={`Okładka książki ${book.title}`} /></div><div class="book-copy"><p class="eyebrow"><span></span> Książka · {book.year}</p><h1>{book.title}</h1>{book.subtitle && <p class="subtitle">{book.subtitle}</p>}<p class="author-line">autorstwa <a href="#autor">{author.name}</a></p><div class="rule"></div><h2>O książce</h2><p class="description">{book.description}</p><div class="formats"><h2>Wybierz format</h2>{book.formats.length ? book.formats.map((format) => <a class="format-link" href={format.href} download><span><b>{format.label}</b><small>{format.detail}</small></span><span class="download-icon" aria-hidden="true">↓</span></a>) : <p class="coming-soon">Pliki tej książki pojawią się tutaj wkrótce.</p>}</div></div></article>
  <section class="author-section" id="autor"><div class="author-avatar" aria-hidden="true">{author.name.split(' ').map((part) => part[0]).join('')}</div><div class="author-bio"><p class="eyebrow"><span></span> Poznajmy się</p><h2>{author.name}</h2><p>{author.bio}</p></div></section>
  {otherBooks.length > 0 && <section class="more-books"><div class="more-heading"><div><p class="eyebrow"><span></span> Więcej od autora</p><h2>Inne książki <em>{author.name.split(' ')[0]}.</em></h2></div><a href="/#ksiazki">Cały katalog <span aria-hidden="true">↗</span></a></div><div class="book-grid">{otherBooks.map((item) => <BookCard book={item} authorName={author.name} />)}</div></section>}
</BaseLayout>
<style>
  .breadcrumbs { max-width: 1120px; margin: auto; padding: 28px 20px; display: flex; gap: 11px; color: #999b92; font-size: 11px; }.breadcrumbs a { color: #69756a; text-decoration: none; }.breadcrumbs a:hover { color: #ae674a; }.detail { max-width: 1020px; margin: 24px auto 85px; padding: 0 20px; display: grid; grid-template-columns: .78fr 1fr; gap: 82px; align-items: start; }.cover-wrap { max-width: 365px; box-shadow: 0 20px 45px #283b2d1c; }.cover-wrap img { display: block; width: 100%; }.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0; color: #747d72; font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #c67d5a; } h1, h2 { font-family: 'Playfair Display', serif; font-weight: 400; letter-spacing: -.035em; }.book-copy h1 { margin: 16px 0 8px; color: #293b31; font-size: clamp(38px, 5vw, 56px); line-height: 1.08; }.subtitle { margin: 0; color: #7a8178; font-family: 'Playfair Display', serif; font-size: 18px; }.author-line { margin: 19px 0 0; color: #7b8279; font-size: 12px; }.author-line a { color: #a65f43; text-decoration: none; font-weight: 600; }.rule { margin: 25px 0; height: 1px; background: #e7e5dc; }.book-copy h2 { margin: 0 0 11px; font-size: 22px; }.description { margin: 0; color: #667168; font-size: 14px; line-height: 1.9; }.formats { margin-top: 31px; }.formats h2 { margin-bottom: 14px; }.format-link { display: flex; align-items: center; justify-content: space-between; padding: 13px 15px; margin: 8px 0; border: 1px solid #e2e4db; border-radius: 3px; text-decoration: none; transition: border-color .2s; }.format-link:hover { border-color: #bd7958; }.format-link > span:first-child { display: flex; flex-direction: column; gap: 4px; }.format-link b { color: #314738; font-size: 12px; }.format-link small { color: #8b9087; font-size: 10px; }.download-icon { color: #b46d4e; font-size: 19px; }.coming-soon { padding: 14px 15px; border: 1px solid #e2e4db; color: #838a80; font-size: 12px; line-height: 1.6; }
  .author-section { max-width: 920px; margin: 0 auto 80px; padding: 35px 40px; display: flex; align-items: center; gap: 30px; background: #edf0e9; }.author-avatar { display: grid; place-items: center; flex: 0 0 82px; width: 82px; height: 82px; border-radius: 50%; background: #d8e1d4; color: #526c57; font-family: 'Playfair Display', serif; font-size: 22px; }.author-bio h2 { margin: 10px 0; font-size: 31px; }.author-bio > p:last-child { max-width: 620px; margin: 0; color: #6e786d; font-size: 13px; line-height: 1.8; }.more-books { max-width: 1120px; margin: 0 auto 85px; padding: 0 20px; }.more-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 27px; }.more-heading h2 { margin: 10px 0 0; font-size: 35px; }.more-heading h2 em { color: #b46d4e; }.more-heading > a { margin-bottom: 5px; color: #526b59; text-decoration: none; font-size: 11px; font-weight: 600; }.more-heading > a span { margin-left: 6px; color: #bd7958; }.book-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; }
  @media (max-width: 700px) { .detail { grid-template-columns: 1fr; gap: 32px; margin-top: 5px; }.cover-wrap { width: min(75%, 330px); margin: auto; }.book-copy h1 { font-size: 43px; }.author-section { margin: 0 20px 60px; padding: 25px 22px; align-items: flex-start; gap: 18px; }.author-avatar { flex-basis: 58px; width: 58px; height: 58px; font-size: 17px; }.author-bio h2 { font-size: 25px; }.more-books { margin-bottom: 60px; }.more-heading h2 { font-size: 29px; } }
</style>
